---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import GeometricWeb from '../components/GeometricWeb.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  noindex?: boolean;
  publishDate?: Date;
  tags?: string[];
  geometricWeb?: boolean;
}

const {
  title,
  description,
  image,
  ogType,
  canonicalURL,
  noindex,
  publishDate,
  tags,
  geometricWeb = false,
} = Astro.props;

const siteName = 'Wagner Caetano - Senior Software Engineer';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SEO
      title={fullTitle}
      headline={title}
      description={description}
      image={image}
      ogType={ogType}
      canonicalURL={canonicalURL}
      noindex={noindex}
      publishDate={publishDate}
      tags={tags}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col relative">
    {geometricWeb && <GeometricWeb />}
    <div class="relative z-10 flex min-h-screen flex-col">
      <Navigation />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
