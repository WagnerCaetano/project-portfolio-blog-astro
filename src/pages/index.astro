---
import Layout from '../layouts/Layout.astro';

// Placeholder data - customize as needed
const skills = {
  languages: ['Java', 'Javascript', 'TypeScript', 'Go', 'Python'],
  frameworks: ['Spring', 'Webflux', 'Angular', 'Astro', 'React'],
  databases: ['MongoDB', 'Redis', 'MySQL'],
  tools: ['Git', 'Docker', 'Kubernetes', 'AWS', 'CI/CD'],
};

const workExperience = [
  {
    company: 'CI&T',
    role: 'Senior Software Engineer',
    period: 'Mar 2024 - Present',
    description: 'Working for a major bank client, developing a BFF for a high-traffic marketing platform.',
    achievements: [
      'Migrate servlet java application to webflux reducing response time by 400ms.',
      'Apply JVM tunning for a BFF to increase throughput and reduce latency.',
      'Help coordinate tasks and mentor junior developers, fostering a collaborative and high-performing team environment.',
    ],
  },
  {
    company: 'CI&T',
    role: 'Software Engineer',
    period: 'Jul 2021 - Feb 2024',
    description: 'Working for a major bank client, developing an APP webview and BFF to handle customers data and registry.',
    achievements: [
      'Implement cloud migration strategy for a legacy spring application, successfully transitioning to AWS EKS architecture.',
      'Examine the integrations between APIs, such as the potential impact of modifying one part of the flow on the BFF.',
      'Migrate legacy spring application using internal framework to a modern internal framework.',
    ],
  },
  {
    company: 'CI&T',
    role: 'Junior Software Engineer',
    period: 'Feb 2021 - Jun 2021',
    description: 'Leading development of scalable microservices architecture and mentoring junior developers.',
    achievements: [
      'Design, write, read, test, and correct code for new software.',
      'Evaluate simple interrelationships between programs, such as whether a contemplated change in one part of a program would cause unwanted results in a related part.',
      'Write, modify, integrate and test software code for Internet and mobile applications.',
    ],
  },
  {
    company: 'CI&T',
    role: 'Software Engineer Intern',
    period: 'Feb 2020 - Feb 2021',
    description: 'Leading development of scalable microservices architecture and mentoring junior developers.',
    achievements: [
      'Learn best practices of coding, testing and architecture to produce software.',
      'Participate in different meetings and rituals of Agile.',
      'Study technologies from the client’s stack on provided study platforms.',
    ],
  },
];

const education = [
  {
    institution: 'Centro Universitário UniMetrocamp',
    degree: 'Bachelor in Computer Science',
    period: '2021 - 2024',
    details: 'Grade: 8.35/10',
  },
  {
    institution: 'Colégio Técnico de Campinas - Unicamp',
    degree: "Technician in System's Development",
    period: '2018 - 2021',
  }
];

const certifications = [
  {
    name: 'Google Project Management Professional Certificate (PT)',
    issuer: 'Coursera',
    date: '2023',
  },
  {
    name: 'AWS Certified Cloud Practitioner',
    issuer: 'Amazon Web Services (AWS)',
    date: '2022',
  },
  {
    name: 'Voxy Proficiency Achievement Certificate - Low Advanced',
    issuer: 'Voxy',
    date: '2022',
  },
];
---

<Layout
  title="Wagner Caetano - Senior Software Engineer"
  description="Introduction of a Senior Software Engineer specializing in building scalable applications and sharing knowledge through technical writing."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-primary-50 to-white dark:from-dark-surface dark:to-dark-bg py-20 md:py-32">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8">
          <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-primary-400 to-primary-600 dark:from-blue-500 dark:to-blue-700 flex items-center justify-center text-white text-4xl font-bold">
            WC
          </div>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-secondary-900 dark:text-secondary-100 mb-6">
          Hi, I'm Wagner Caetano
        </h1>
        <p class="text-xl md:text-2xl text-secondary-600 dark:text-secondary-300 mb-8 max-w-2xl mx-auto">
          Senior Software Engineer with a passion for designing and developing innovative software solutions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#contact" class="btn btn-primary text-lg px-8 py-3">
            Get in Touch
          </a>
          <a href="#experience" class="btn btn-secondary text-lg px-8 py-3">
            View Experience
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="section bg-white dark:bg-dark-surface">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="section-title text-center">About Me</h2>
        <div class="prose prose-lg max-w-none text-secondary-600 dark:text-secondary-300 dark:prose-invert">
          <p>
            I'm a Senior Software Engineer with over 6 years of experience in building robust, scalable applications. As a student and worker, I’ve gained extensive knowledge and expertise in both frontend and backend development.
          </p>
          <br>
          <p>
            Throughout my career, I've had the opportunity to work with diverse teams and tackle complex technical challenges. I believe in writing clean, maintainable code and continuously learning new technologies to stay at the forefront of software development.
          </p>
          <br>
          <p>
            When I'm not coding, you'll find me writing technical blog posts, contributing to open-source projects, or exploring new technologies. I'm passionate about sharing knowledge and helping others grow in their software development journey.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="section bg-secondary-50 dark:bg-dark-bg">
    <div class="container">
      <h2 class="section-title text-center">Skills & Technologies</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Languages -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-lg font-semibold text-secondary-900 dark:text-secondary-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            Languages
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.languages.map((skill) => (
              <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- Frameworks -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-lg font-semibold text-secondary-900 dark:text-secondary-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            Frameworks
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.frameworks.map((skill) => (
              <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- Databases -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-lg font-semibold text-secondary-900 dark:text-secondary-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
            Databases
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.databases.map((skill) => (
              <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- Tools -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-lg font-semibold text-secondary-900 dark:text-secondary-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Tools & DevOps
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.tools.map((skill) => (
              <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience" class="section bg-white dark:bg-dark-surface">
    <div class="container">
      <h2 class="section-title text-center">Work Experience</h2>
      <div class="max-w-3xl mx-auto space-y-8">
        {workExperience.map((job, index) => (
          <div class="relative pl-8 border-l-2 border-primary-200 dark:border-primary-800 pb-8 last:pb-0">
            <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-primary-600 dark:bg-blue-500"></div>
            <div class="bg-secondary-50 dark:bg-secondary-900/50 rounded-lg p-6">
              <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                <h3 class="text-xl font-semibold text-secondary-900 dark:text-secondary-100">{job.role}</h3>
                <span class="text-sm text-primary-600 dark:text-blue-400 font-medium bg-primary-100 dark:bg-primary-900/30 px-3 py-1 rounded-full">
                  {job.period}
                </span>
              </div>
              <p class="text-lg text-primary-600 dark:text-blue-400 font-medium mb-3">{job.company}</p>
              <p class="text-secondary-600 dark:text-secondary-300 mb-4">{job.description}</p>
              <ul class="space-y-2">
                {job.achievements.map((achievement) => (
                  <li class="flex items-start gap-2 text-secondary-600 dark:text-secondary-300">
                    <svg class="w-5 h-5 text-primary-600 dark:text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education & Certifications Section -->
  <section id="education" class="section bg-secondary-50 dark:bg-dark-bg">
    <div class="container">
      <h2 class="section-title text-center">Education & Certifications</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Education -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-xl font-semibold text-secondary-900 dark:text-secondary-100 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
            Education
          </h3>
          <div class="space-y-4">
            {education.map((edu) => (
              <div class="border-l-2 border-primary-200 dark:border-primary-800 pl-4">
                <h4 class="font-semibold text-secondary-900 dark:text-secondary-100">{edu.degree}</h4>
                <p class="text-primary-600 dark:text-blue-400">{edu.institution}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">{edu.period}</p>
                <p class="text-sm text-secondary-600 dark:text-secondary-300 mt-1">{edu.details}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div class="bg-white dark:bg-dark-surface rounded-lg p-6 shadow-md">
          <h3 class="text-xl font-semibold text-secondary-900 dark:text-secondary-100 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-primary-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            Certifications
          </h3>
          <div class="space-y-4">
            {certifications.map((cert) => (
              <div class="border-l-2 border-primary-200 dark:border-primary-800 pl-4">
                <h4 class="font-semibold text-secondary-900 dark:text-secondary-100">{cert.name}</h4>
                <p class="text-primary-600 dark:text-blue-400">{cert.issuer}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">{cert.date}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section bg-white dark:bg-dark-surface">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="section-title">Get in Touch</h2>
        <p class="text-lg text-secondary-600 dark:text-secondary-300 mb-8">
          I'm always open to discussing new opportunities, interesting projects, or just having a chat about technology.
        </p>
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <a
            href="mailto:your.email@example.com"
            class="btn btn-primary text-lg px-8 py-3 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Send Email
          </a>
          <a
            href="https://www.linkedin.com/in/wagner-caetano/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary text-lg px-8 py-3 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </a>
          <a
            href="https://github.com/WagnerCaetano"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary text-lg px-8 py-3 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
