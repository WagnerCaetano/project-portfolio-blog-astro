---
---

<canvas
  id="geometric-web"
  class="fixed inset-0 -z-10 pointer-events-none"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('geometric-web');
  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const NODE_COUNT = isMobile ? 80 : 140;
      const LINK_DIST = isMobile ? 120 : 145;
      const FOV = 420;
      const ROT_SPEED = reduceMotion ? 0 : 0.00012;

      let width = 0;
      let height = 0;
      let dpr = 1;
      let points = [];
      let mouse = { x: 0, y: 0, active: false };
      let targetMouse = { x: 0, y: 0 };
      let rotation = { x: 0.35, y: 0.2 };
      let raf = 0;
      let last = performance.now();

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function seedPoints() {
        points = [];
        const spread = Math.min(width, height) * 0.55;
        for (let i = 0; i < NODE_COUNT; i++) {
          const u = Math.random();
          const v = Math.random();
          const theta = 2 * Math.PI * u;
          const phi = Math.acos(2 * v - 1);
          const r = spread * (0.45 + Math.random() * 0.55);
          const x = r * Math.sin(phi) * Math.cos(theta);
          const y = r * Math.sin(phi) * Math.sin(theta) * 0.72;
          const z = r * Math.cos(phi);
          points.push({ x, y, z, ox: x, oy: y, oz: z });
        }
      }

      function rotate(p, ax, ay) {
        const cosY = Math.cos(ay);
        const sinY = Math.sin(ay);
        const cosX = Math.cos(ax);
        const sinX = Math.sin(ax);

        let x = p.x * cosY - p.z * sinY;
        let z = p.x * sinY + p.z * cosY;
        let y = p.y * cosX - z * sinX;
        z = p.y * sinX + z * cosX;
        return { x, y, z, ox: p.ox, oy: p.oy, oz: p.oz };
      }

      function project(p) {
        const z = p.z + FOV * 0.85;
        if (z <= 40) return null;
        const scale = FOV / z;
        return {
          x: width / 2 + p.x * scale,
          y: height / 2 + p.y * scale,
          scale,
          z,
        };
      }

      function drawNode(p, alpha) {
        const size = Math.max(1.2, 2.6 * p.scale);
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(Math.PI / 4);
        ctx.strokeStyle = `rgba(148, 174, 201, ${alpha})`;
        ctx.lineWidth = 1;
        ctx.strokeRect(-size, -size, size * 2, size * 2);
        ctx.fillStyle = `rgba(120, 150, 180, ${alpha * 0.35})`;
        ctx.fillRect(-size * 0.35, -size * 0.35, size * 0.7, size * 0.7);
        ctx.restore();
      }

      function frame(now) {
        const dt = Math.min(32, now - last);
        last = now;

        if (!reduceMotion) {
          rotation.y += ROT_SPEED * dt;
          rotation.x += ROT_SPEED * 0.35 * dt;
        }

        mouse.x += (targetMouse.x - mouse.x) * 0.08;
        mouse.y += (targetMouse.y - mouse.y) * 0.08;

        ctx.clearRect(0, 0, width, height);

        const grad = ctx.createRadialGradient(
          width * 0.5,
          height * 0.35,
          0,
          width * 0.5,
          height * 0.5,
          Math.max(width, height) * 0.75
        );
        grad.addColorStop(0, 'rgba(22, 32, 48, 0.0)');
        grad.addColorStop(1, 'rgba(8, 12, 20, 0.45)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, width, height);

        const projected = [];
        const influence = mouse.active ? 1 : 0.25;
        const mx = mouse.active ? mouse.x : width * 0.5;
        const my = mouse.active ? mouse.y : height * 0.4;

        for (let i = 0; i < points.length; i++) {
          const base = points[i];
          const breath = reduceMotion ? 0 : Math.sin(now * 0.00015 + i) * 3;
          const rotated = rotate(
            {
              x: base.ox + breath,
              y: base.oy,
              z: base.oz - breath * 0.5,
              ox: base.ox,
              oy: base.oy,
              oz: base.oz,
            },
            rotation.x,
            rotation.y
          );
          let proj = project(rotated);
          if (proj) {
            const dx = proj.x - mx;
            const dy = proj.y - my;
            const dist = Math.hypot(dx, dy) || 1;
            const pull = Math.max(0, 1 - dist / 280) * 28 * influence;
            proj = {
              ...proj,
              x: proj.x - (dx / dist) * pull,
              y: proj.y - (dy / dist) * pull,
            };
          }
          projected[i] = proj;
        }

        for (let i = 0; i < projected.length; i++) {
          const a = projected[i];
          if (!a) continue;
          for (let j = i + 1; j < projected.length; j++) {
            const b = projected[j];
            if (!b) continue;
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const dist = Math.hypot(dx, dy);
            if (dist > LINK_DIST) continue;
            const depth = Math.min(a.scale, b.scale);
            const alpha = (1 - dist / LINK_DIST) * 0.45 * Math.min(1, depth * 1.2);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(110, 140, 170, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        for (let i = 0; i < projected.length; i += 3) {
          const a = projected[i];
          const b = projected[i + 1];
          const c = projected[i + 2];
          if (!a || !b || !c) continue;
          const ab = Math.hypot(a.x - b.x, a.y - b.y);
          const bc = Math.hypot(b.x - c.x, b.y - c.y);
          const ca = Math.hypot(c.x - a.x, c.y - a.y);
          if (ab > LINK_DIST * 0.9 || bc > LINK_DIST * 0.9 || ca > LINK_DIST * 0.9) continue;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.lineTo(c.x, c.y);
          ctx.closePath();
          ctx.fillStyle = 'rgba(90, 120, 150, 0.04)';
          ctx.fill();
        }

        for (const p of projected) {
          if (!p) continue;
          const alpha = Math.min(0.85, 0.25 + p.scale * 0.45);
          drawNode(p, alpha);
        }

        if (mouse.active) {
          for (const p of projected) {
            if (!p) continue;
            const dist = Math.hypot(p.x - mouse.x, p.y - mouse.y);
            if (dist > 220) continue;
            const alpha = (1 - dist / 220) * 0.35;
            ctx.beginPath();
            ctx.moveTo(mouse.x, mouse.y);
            ctx.lineTo(p.x, p.y);
            ctx.strokeStyle = `rgba(160, 190, 220, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, 3, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(180, 205, 225, 0.55)';
          ctx.fill();
        }

        raf = requestAnimationFrame(frame);
      }

      function onMove(e) {
        targetMouse.x = e.clientX;
        targetMouse.y = e.clientY;
        mouse.active = true;
      }

      function onLeave() {
        mouse.active = false;
      }

      function onTouch(e) {
        if (!e.touches[0]) return;
        targetMouse.x = e.touches[0].clientX;
        targetMouse.y = e.touches[0].clientY;
        mouse.active = true;
      }

      resize();
      seedPoints();
      targetMouse.x = width * 0.5;
      targetMouse.y = height * 0.4;
      mouse.x = targetMouse.x;
      mouse.y = targetMouse.y;
      raf = requestAnimationFrame(frame);

      window.addEventListener('resize', () => {
        resize();
        seedPoints();
      });
      window.addEventListener('mousemove', onMove, { passive: true });
      window.addEventListener('mouseleave', onLeave);
      window.addEventListener('touchstart', onTouch, { passive: true });
      window.addEventListener('touchmove', onTouch, { passive: true });
      window.addEventListener('touchend', onLeave);

      // Keep raf reference used so bundlers don't strip it
      void raf;
    }
  }
</script>
