---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  githubRepo?: string;
  coverImage?: string;
}

const { title, description, date, slug, tags = [], githubRepo, coverImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<article class="bg-white dark:bg-dark-surface rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
  <!-- Cover Image -->
  {coverImage && (
    <div class="aspect-video overflow-hidden">
      <img
        src={coverImage}
        alt={`Cover image for ${title}`}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6">
    <!-- Title -->
    <h2 class="text-xl font-bold text-secondary-900 dark:text-secondary-100 mb-2">
      <a href={`/blog/${slug}`} class="hover:text-primary-600 dark:hover:text-blue-400 transition-colors">
        {title}
      </a>
    </h2>

    <!-- Date -->
    <time class="text-sm text-secondary-500 dark:text-secondary-400 mb-3 block" datetime={date.toISOString()}>
      {formattedDate}
    </time>

    <!-- Description -->
    <p class="text-secondary-600 dark:text-secondary-300 mb-4 line-clamp-3">{description}</p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span
            class="px-3 py-1 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full"
          >
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Actions -->
    <div class="flex items-center justify-between">
      <a
        href={`/blog/${slug}`}
        class="text-primary-600 dark:text-blue-400 font-medium hover:text-primary-700 dark:hover:text-blue-300 transition-colors"
      >
        Read more →
      </a>

      {githubRepo && (
        <a
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-secondary-600 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-blue-400 transition-colors"
          aria-label="View GitHub repository"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"
            />
          </svg>
          <span>GitHub</span>
        </a>
      )}
    </div>
  </div>
</article>
