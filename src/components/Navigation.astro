---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const homeHref = base;
const blogHref = `${base}blog`;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const isHome = normalize(currentPath) === normalize(base);
const isBlog = currentPath.includes('/blog');
---

<nav class="sticky top-0 z-50 bg-white/95 dark:bg-dark-surface/95 backdrop-blur-sm border-b border-secondary-200 dark:border-secondary-800 shadow-sm">
  <div class="container">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={homeHref} class="text-xl font-bold text-primary-600 hover:text-primary-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
        Wagner Caetano
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a
          href={homeHref}
          class={`font-medium transition-colors ${
            isHome
              ? 'text-primary-600 dark:text-blue-400'
              : 'text-secondary-600 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-blue-400'
          }`}
        >
          About
        </a>
        <a
          href={blogHref}
          class={`font-medium transition-colors ${
            isBlog
              ? 'text-primary-600 dark:text-blue-400'
              : 'text-secondary-600 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-blue-400'
          }`}
        >
          Blog
        </a>
        <a
          href="#contact"
          class="btn btn-primary"
        >
          Contact
        </a>
        <ThemeToggle />
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center space-x-2">
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          class="p-2 rounded-md text-secondary-600 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-blue-400 hover:bg-secondary-100 dark:hover:bg-secondary-800"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-3">
        <a
          href={homeHref}
          class={`font-medium transition-colors ${
            isHome
              ? 'text-primary-600 dark:text-blue-400'
              : 'text-secondary-600 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-blue-400'
          }`}
        >
          About
        </a>
        <a
          href={blogHref}
          class={`font-medium transition-colors ${
            isBlog
              ? 'text-primary-600 dark:text-blue-400'
              : 'text-secondary-600 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-blue-400'
          }`}
        >
          Blog
        </a>
        <a
          href="#contact"
          class="btn btn-primary text-center justify-center"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
