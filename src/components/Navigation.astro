---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const homeHref = base;
const blogHref = `${base}blog`;
const contactHref = `${base}#contact`;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const isHome = normalize(currentPath) === normalize(base);
const isBlog = currentPath.includes('/blog');
---

<nav class="sticky top-0 z-50 border-b border-white/10 bg-dark-bg/70 backdrop-blur-xl">
  <div class="container">
    <div class="flex items-center justify-between h-16">
      <a href={homeHref} class="text-xl font-semibold tracking-tight text-secondary-50 hover:text-primary-300 transition-colors">
        Wagner Caetano
      </a>

      <div class="hidden md:flex items-center space-x-8">
        <a
          href={homeHref}
          class={`font-medium transition-colors ${
            isHome
              ? 'text-primary-300'
              : 'text-secondary-300 hover:text-primary-200'
          }`}
        >
          About
        </a>
        <a
          href={blogHref}
          class={`font-medium transition-colors ${
            isBlog
              ? 'text-primary-300'
              : 'text-secondary-300 hover:text-primary-200'
          }`}
        >
          Blog
        </a>
        <a href={contactHref} class="btn btn-primary">
          Contact
        </a>
      </div>

      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-button"
          class="p-2 rounded-md text-secondary-300 hover:text-primary-200 hover:bg-white/5"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-3">
        <a
          href={homeHref}
          class={`font-medium transition-colors ${
            isHome
              ? 'text-primary-300'
              : 'text-secondary-300 hover:text-primary-200'
          }`}
        >
          About
        </a>
        <a
          href={blogHref}
          class={`font-medium transition-colors ${
            isBlog
              ? 'text-primary-300'
              : 'text-secondary-300 hover:text-primary-200'
          }`}
        >
          Blog
        </a>
        <a href={contactHref} class="btn btn-primary text-center justify-center">
          Contact
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
