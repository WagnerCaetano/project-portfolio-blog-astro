---
interface Props {
  title: string;
  /** Plain title for structured data (without site name suffix) */
  headline?: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** Site-relative path without base prefix, e.g. `/blog/my-post` or `/` */
  canonicalURL?: string;
  noindex?: boolean;
  publishDate?: Date;
  tags?: string[];
}

const {
  title,
  headline,
  description,
  image = '/og-image.jpg',
  ogType = 'website',
  canonicalURL,
  noindex = false,
  publishDate,
  tags = [],
} = Astro.props;

const siteURL = (Astro.site?.href ?? 'https://wagnercaetano.github.io/project-portfolio-blog-astro').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const basePath = base.replace(/\/$/, ''); // e.g. /project-portfolio-blog-astro

function toSiteAbsolute(pathWithoutBase: string): string {
  const normalized = pathWithoutBase.replace(/\/$/, '') || '/';
  if (normalized === '/') return siteURL;
  return `${siteURL}${normalized.startsWith('/') ? normalized : `/${normalized}`}`;
}

// Explicit canonicals are site-relative (no base). Otherwise strip base from the current pathname.
let pathForCanonical = canonicalURL;
if (!pathForCanonical) {
  const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
  pathForCanonical = pathname.startsWith(basePath)
    ? pathname.slice(basePath.length) || '/'
    : pathname;
}

const fullURL = toSiteAbsolute(pathForCanonical);

const fullImageURL = image.startsWith('http')
  ? image
  : `${siteURL}${image.startsWith('/') ? image : `/${image}`}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Wagner Caetano',
  jobTitle: 'Senior Software Engineer',
  url: siteURL,
  sameAs: [
    'https://github.com/WagnerCaetano',
    'https://www.linkedin.com/in/wagner-caetano/',
  ],
};

const blogPostingSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: headline ?? title,
        description,
        image: fullImageURL,
        url: fullURL,
        datePublished: publishDate?.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Wagner Caetano',
          url: siteURL,
        },
        publisher: {
          '@type': 'Person',
          name: 'Wagner Caetano',
          url: siteURL,
        },
        ...(tags.length ? { keywords: tags.join(', ') } : {}),
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': fullURL,
        },
      }
    : null;
---

<!-- Basic Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="icon" href={`${base}favicon.ico`} />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="author" content="Wagner Caetano" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Wagner Caetano" />
<meta property="og:url" content={fullURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
{ogType === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{ogType === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />

<!-- Canonical URL -->
<link rel="canonical" href={fullURL} />

<!-- No Index (if needed) -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
{blogPostingSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
)}
